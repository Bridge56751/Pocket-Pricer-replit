# ─────────────────────────────────────────────────────────────────────────────
#  Pocket Pricer — environment template
# ─────────────────────────────────────────────────────────────────────────────
#  Usage:  cp .env.example .env.local  →  fill values  →  see README "Local Development".
#
#  This file IS committed to git. Never put real secrets here.
#  Real values live in .env.local, which is gitignored (see .gitignore line 34).
# ─────────────────────────────────────────────────────────────────────────────


# ── Backend: Supabase (REQUIRED — server crashes without these) ──────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional — only used by the boot-time ALTER TABLE in server/supabase.ts.
# Safe to leave blank; the migration just becomes a no-op.
SUPABASE_DB_URL=


# ── Backend: paid third-party APIs (optional) ────────────────────────────────
# Endpoints that need a missing key return errors but the server still boots.
SEARCHAPI_API_KEY=
SERPAPI_API_KEY=
SCRAPINGDOG_API_KEY=


# ── Backend: AI query cleaning via Gemini (optional, /api/ebay-sold-search) ──
# On Replit these point at Replit's internal modelfarm proxy. For local dev,
# get a free key from https://aistudio.google.com/apikey and use:
#   AI_INTEGRATIONS_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
#   AI_INTEGRATIONS_GEMINI_API_KEY=<your key>
# Without these, /api/ebay-sold-search still works — just skips the AI cleanup.
AI_INTEGRATIONS_GEMINI_BASE_URL=
AI_INTEGRATIONS_GEMINI_API_KEY=


# ── Backend: image-upload fallbacks (optional) ───────────────────────────────
FREEIMAGE_API_KEY=
IMGBB_API_KEY=


# ── Local backend port ───────────────────────────────────────────────────────
# Default 5050 (macOS AirPlay Receiver squats on 5000; disable in
# System Settings → General → AirDrop & Handoff if you want to use 5000).
# Production (Replit) is unaffected — PORT is set to 5000 in .replit.
PORT=5050


# ── Client (Expo) — public values bundled into the JS shipped to phones ──────
# These are also baked into prod builds via eas.json's env blocks. Setting
# them here only affects local `npm run expo:dev:local` runs.
#
# IMPORTANT NAMING: Expo strips any client-side env var that doesn't start
# with EXPO_PUBLIC_ from the bundle. The Android RevenueCat key has bitten
# this codebase before — without the prefix the Android RC SDK init silently
# fails (no offerings load, "Restore Purchases" doesn't work, etc.).
EXPO_PUBLIC_DOMAIN=localhost:5050
EXPO_PUBLIC_REVENUECAT_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=


# ── Stripe / Resend / TikTok / Vision / etc. ─────────────────────────────────
# Currently unused by the running code (see SECURITY_REVIEW.md P3-1) but
# present in production for future features. Safe to leave blank locally.
SESSION_SECRET=
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
GOOGLE_CLOUD_VISION_API_KEY=
BRIGHTDATA_API_KEY=
EXPO_PUBLIC_TIKTOK_ACCESS_TOKEN=

# RevenueCat REST secret — needed once the P0-1 server-side Pro verification
# fix from EXECUTIVE_BRIEF.md is implemented. Not used by current code.
REVENUECAT_API_KEY=
