{
  "expo": {
    "name": "Pocket Pricer",
    "slug": "ebay-profit-estimator",
    "version": "1.4.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ebayprofit",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ebayprofit.app",
      "buildNumber": "58",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "SKAdNetworkItems": [
          { "SKAdNetworkIdentifier": "mj797d8u6f.skadnetwork" },
          { "SKAdNetworkIdentifier": "gta9lk7ez23.skadnetwork" },
          { "SKAdNetworkIdentifier": "v9wttpbfk9.skadnetwork" }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2E7D5B",
        "foregroundImage": "./assets/images/icon.png"
      },
      "package": "com.ebayprofit.app",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "./plugins/withFirebaseStaticFramework",
      "expo-build-properties",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#2E7D5B",
          "dark": {
            "backgroundColor": "#2E7D5B"
          }
        }
      ],
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "Pocket Pricer uses your camera to take photos of products so it can identify them and show you current prices across stores like Amazon, Walmart, and Target. For example, you can photograph a pair of shoes to instantly see what they sell for online."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Pocket Pricer accesses your photo library so you can select product images to scan. For example, you can choose a saved photo of an item to look up its current market value across multiple stores."
        }
      ],
      [
        "@react-native-firebase/app",
        {
          "ios": {
            "googleServicesFile": "./GoogleService-Info.plist"
          }
        }
      ],
      [
        "react-native-appsflyer",
        {
          "shouldUseStrictMode": false
        }
      ],
      [
        "react-native-fbsdk-next",
        {
          "appID": "901142736144530",
          "clientToken": "dd2306374faf28e8dc2facbb05f0bbe0",
          "displayName": "Pocket Pricer",
          "advertiserIDCollectionEnabled": true,
          "autoLogAppEventsEnabled": true,
          "isAutoInitEnabled": true,
          "iosUserTrackingPermission": "Pocket Pricer uses this identifier to deliver personalized ads and measure ad performance. You can opt out at any time."
        }
      ]
    ],
    "experiments": {
      "reactCompiler": true
    }
  }
}
