entrypoint = "README.md"
modules = ["nodejs-22", "postgresql-16", "python-3.11"]

[nix]
channel = "stable-24_05"

[deployment]
deploymentTarget = "vm"
build = ["sh", "-c", "npm run expo:static:build && npm run server:build"]
run = ["npm", "run", "server:prod"]

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 8081
externalPort = 80

[[ports]]
localPort = 8082
externalPort = 3002

[env]
PORT = "5000"

[agent]
stack = "NODEJS"
integrations = ["javascript_gemini_ai_integrations:2.0.0", "stripe:2.0.0", "resend:1.0.0", "github:1.0.0", "sendgrid:1.0.0"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start App"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start Frontend"

[[workflows.workflow]]
name = "Start App"
author = "agent"
mode = "parallel"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start Backend"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start Frontend"

[[workflows.workflow]]
name = "Start Backend"
author = "agent"
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run server:dev"
waitForPort = 5000

[[workflows.workflow]]
name = "Start Frontend"
author = "agent"
mode = "sequential"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "EXPO_OFFLINE=1 npm run expo:dev"

[objectStorage]
defaultBucketID = "replit-objstore-7a381cbe-aa87-4d8f-a4e7-ab55e4546f7a"

[userenv]

[userenv.shared]
EXPO_PUBLIC_REVENUECAT_API_KEY = "appl_HofCsoaVBOUStbnRzQxJWHOmdii"
FREEIMAGE_API_KEY = "6d207e02198a847aa98d0a2a901485a5"
IMGBB_API_KEY = "b4e0e3a7e5e0c4b2d6a8f9c1e3b5d7a9"
VERIFY_PRO_VIA_RC = "true"

[userenv.production]
EXPO_PUBLIC_DOMAIN = "pocketpricerapp.com"
